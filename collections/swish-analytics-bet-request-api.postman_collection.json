              "query": [
                {
                  "disabled": false,
                  "key": "parlay",
                  "value": "<boolean>",
                  "description": "(Required) Specifies if this is a bet request for an accumulator (true) or a single market (false)"
                },
                {
                  "disabled": false,
                  "key": "margin",
                  "value": "<number>",
                  "description": "(Required) Specifies the margin you would like applied to the returned market. Margin must be a value from 0 to 1 & accepts up to 3 decimal places"
                },
                {
                  "disabled": false,
                  "key": "marketAdj",
                  "value": "<boolean>",
                  "description": "(Required) Specifies if this is a request for markets using our market adjusted (true) or non-market adjusted (false) lines"
                },
                {
                  "disabled": false,
                  "key": "sport",
                  "value": "<string>",
                  "description": "(Required) Specifies the sport associated with each leg you are requesting per props object"
                },
                {
                  "disabled": false,
                  "key": "gameId",
                  "value": "<number>",
                  "description": "(Required) Specifies the unique gameId associated with each leg you are requesting per props object"
                },
                {
                  "disabled": false,
                  "key": "playerId",
                  "value": "<number>",
                  "description": "(Required) Specifies the unique playerId associated with each leg you are requesting per props object"
                },
                {
                  "disabled": false,
                  "key": "teamId",
                  "value": "<number>",
                  "description": "(Required) Specifies the unique teamId associated with each leg you are requesting per props object. When requesting match-level markets that are not specifically tied to one team, teamId is still required, but either teamId from the match is allowed"
                },
                {
                  "disabled": false,
                  "key": "statTypeId",
                  "value": "<number>",
                  "description": "(Required) Specifies the unique statTypeId associated with each leg you are requesting per props object"
                },
                {
                  "disabled": false,
                  "key": "lineType",
